# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

OPENAI_API_KEY=sk-your-key-here

# Found under: Databricks sidebar > SQL Warehouses > (your warehouse) > Connection Details
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Personal access token: Databricks > profile icon > Settings > Developer > Access tokens
DATABRICKS_TOKEN=dapi-your-token-here